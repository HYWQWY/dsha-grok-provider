{
  "name": "dsha-grok-provider",
  "version": "0.1.0",
  "description": "DSHA / DeepSeek Harness 插件：用 X Premium / SuperGrok 订阅作为 Grok 大模型供应商（OAuth，无需 API Key）。面向 DSHA 安卓端链接安装。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsha",
    "dsh",
    "deepseek-harness",
    "grok",
    "oauth",
    "subscription",
    "xai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HYWQWY/dsha-grok-provider.git"
  },
  "bugs": {
    "url": "https://github.com/HYWQWY/dsha-grok-provider/issues"
  },
  "homepage": "https://github.com/HYWQWY/dsha-grok-provider#readme"
}
